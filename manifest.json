{
  "manifest_version": 3,
  "name": "Magic Pen",
  "version": "0.2.3",
  "description": "Draw, highlight, laser-point and screen-record on any page. Recordings save straight to disk.",
  "permissions": [
    "desktopCapture",
    "offscreen",
    "downloads",
    "storage",
    "activeTab",
    "scripting",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Toggle Magic Pen (draw on this page)",
    "default_icon": {
      "16": "src/icons/magicpen-16.png",
      "32": "src/icons/magicpen-32.png",
      "48": "src/icons/magicpen-48.png",
      "128": "src/icons/magicpen-128.png"
    }
  },
  "icons": {
    "16": "src/icons/magicpen-16.png",
    "32": "src/icons/magicpen-32.png",
    "48": "src/icons/magicpen-48.png",
    "128": "src/icons/magicpen-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/stroke-renderer.js",
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
